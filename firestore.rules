// firestore.rules
// Deploy with: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Projects — public read, write requires auth
    match /projects/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Leaderboard — public read, anyone can add a score (no auth required)
    match /leaderboard/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['playerName','score','game','createdAt'])
                    && request.resource.data.playerName is string
                    && request.resource.data.playerName.size() <= 30
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0;
      allow update, delete: if request.auth != null;
    }

    // Resume metadata — public read, write requires auth
    match /resume_meta/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
